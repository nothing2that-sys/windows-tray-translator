{
  "General": {
    "TranslationEnabled": true,
    "RunAtWindowsStartup": false,
    "ShowTranslatingPopup": true,
    "PopupTimeoutMs": 5000,
    "EnableLogging": true,
    "LogRetentionDays": 14
